# Banco de dados
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=nfe_sistema
MYSQL_USER=nfe_user
MYSQL_PASSWORD=nfe_pass
DATABASE_URL=mysql+pymysql://nfe_user:nfe_pass@db:3306/nfe_sistema

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# IA (Google Gemini)
GEMINI_API_KEY=coloque_sua_chave_aqui

# Auth
SECRET_KEY=troque_por_uma_chave_secreta_longa

# URL base pública da API, usada para montar os links de aprovação/reprovação
# de cadastro enviados por e-mail
API_BASE_URL=http://localhost:8000

# E-mail (SMTP) -- em dev, aponta para o serviço "mailhog" do docker-compose
# (interface web em http://localhost:8025, não envia e-mail de verdade)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
EMAIL_FROM=no-reply@leitorxml.local
