FROM node:22-alpine

WORKDIR /code

# Cache de layer: só copia os manifests primeiro, então o `npm install`
# só reexecuta quando package.json/package-lock.json mudam, não a cada
# alteração de código (o volume `.:/code` do compose sobrescreve o
# resto em dev, mas o node_modules fica no volume nomeado web_node_modules,
# não no bind mount -- ver docker-compose.yml).
COPY web/package.json web/package-lock.json* ./
RUN npm install

COPY web/ .

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
